{
  "name": "excel-desktop-app",
  "version": "0.1.1",
  "description": "Desktop workspace for Excel automation, validation, backup, and reporting workflows.",
  "type": "module",
  "main": "public/electron/electron.cjs",
  "author": "rlahfld54",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rlahfld54/excel-desktop-app.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"npm run electron\"",
    "vite": "vite",
    "electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "check": "npm run build",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "seed:automotive": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed-automotive-data.cjs",
    "seed:automotive:inspect": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed-automotive-data.cjs --inspect",
    "verify:sales-query": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/verify-sales-query.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "better-sqlite3": "^12.10.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^8.0.11",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.2",
    "react-transition-group": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.32",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.asterworks.exceldesktopapp",
    "productName": "Excel Desktop App",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "dist/**/*",
      "public/electron/**/*",
      "public/database/**/*",
      "public/icon.ico",
      "public/icon.svg",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "./public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
